@model MeraKharcha.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "System Administration Console";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-shield-lock-fill text-danger me-2"></i>Administration Center</h3>
        <p class="text-muted small mb-0">System metrics, user accounts, groups, and security audit logs</p>
    </div>
    <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill">
        <i class="bi bi-shield-check me-1"></i>SystemAdmin Role Verified
    </span>
</div>

<!-- Global KPI Metrics -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <span class="text-muted small fw-semibold">Total Users</span>
            <h3 class="fw-bold text-primary mb-0 mt-1">@Model.TotalUsers</h3>
            <small class="text-muted">Registered accounts</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <span class="text-muted small fw-semibold">Total Groups</span>
            <h3 class="fw-bold text-success mb-0 mt-1">@Model.TotalGroups</h3>
            <small class="text-muted">Active workspaces</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <span class="text-muted small fw-semibold">Expenses Logged</span>
            <h3 class="fw-bold text-info mb-0 mt-1">@Model.TotalExpensesCount</h3>
            <small class="text-muted">Volume: ₹@Model.TotalExpenseVolume.ToString("N0")</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <span class="text-muted small fw-semibold">Settled Volume</span>
            <h3 class="fw-bold text-warning mb-0 mt-1">₹@Model.TotalSettledVolume.ToString("N0")</h3>
            <small class="text-muted">@Model.TotalSettlementsCount settlements</small>
        </div>
    </div>
</div>

<!-- Admin Quick Navigation Tabs/Links -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-people me-1"></i> Manage Users
    </a>
    <a asp-area="Admin" asp-controller="Groups" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-collection me-1"></i> Manage Groups
    </a>
    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-tags me-1"></i> Expense Categories
    </a>
    <a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-journal-text me-1"></i> Security Audit Trail
    </a>
</div>

<!-- Recent System Activity Logs -->
<div class="card-modern p-4">
    <h5 class="fw-bold mb-3"><i class="bi bi-clock-history me-2 text-primary"></i>Recent System Audit Trail</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th>Timestamp</th>
                    <th>Action</th>
                    <th>User</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.RecentLogs)
                {
                    <tr>
                        <td class="text-nowrap text-muted">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>
                            <span class="badge bg-body-secondary text-body">@log.Action</span>
                        </td>
                        <td class="fw-semibold">@(log.User?.FullName ?? "System")</td>
                        <td class="text-wrap">@log.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
