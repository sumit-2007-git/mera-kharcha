@model IEnumerable<MeraKharcha.Models.Category>
@{
    ViewData["Title"] = "Expense Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-tags-fill text-primary me-2"></i>Expense Categories</h3>
        <p class="text-muted small mb-0">Manage global categories, color codes, and visual iconography</p>
    </div>
    <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="bi bi-arrow-left me-1"></i> Admin Console
    </a>
</div>

<div class="row g-4">
    <!-- Categories List -->
    <div class="col-lg-8">
        <div class="card-modern p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Icon</th>
                            <th>Category Name</th>
                            <th>Color Code</th>
                            <th>Usage</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>
                                    <div class="stat-icon-wrapper rounded-circle" style="width: 38px; height: 38px; background-color: @(c.ColorHex)20; color: @c.ColorHex;">
                                        <i class="bi @c.Icon"></i>
                                    </div>
                                </td>
                                <td class="fw-bold">@c.Name</td>
                                <td>
                                    <span class="badge" style="background-color: @c.ColorHex; color: #ffffff;">@c.ColorHex</span>
                                </td>
                                <td>@c.Expenses.Count expenses</td>
                                <td class="text-end">
                                    @if (!c.IsDefault && !c.Expenses.Any())
                                    {
                                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Delete category?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge bg-body-secondary text-muted">Protected</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Create Category Card -->
    <div class="col-lg-4">
        <div class="card-modern p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-plus-circle text-success me-2"></i>Add New Category</h5>
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Category Name *</label>
                    <input type="text" name="name" class="form-control" placeholder="e.g. Fitness & Gym" required />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Bootstrap Icon Class</label>
                    <input type="text" name="icon" class="form-control" value="bi-tag" placeholder="bi-cup-hot, bi-heart-pulse..." />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Color Hex Code</label>
                    <input type="color" name="colorHex" class="form-control form-control-color w-100" value="#4f46e5" />
                </div>

                <button type="submit" class="btn btn-primary w-100 rounded-3 shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Save Category
                </button>
            </form>
        </div>
    </div>
</div>
