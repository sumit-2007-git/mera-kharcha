@model IEnumerable<MeraKharcha.ViewModels.UserManagementItemViewModel>
@{
    ViewData["Title"] = "User Accounts Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>User Management</h3>
        <p class="text-muted small mb-0">Inspect user accounts, assign admin privileges, and manage lockouts</p>
    </div>
    <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="bi bi-arrow-left me-1"></i> Admin Console
    </a>
</div>

<div class="card-modern p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>UPI ID</th>
                    <th>Roles</th>
                    <th>Registered</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@u.FullName</div>
                            <small class="text-muted">@u.Email</small>
                        </td>
                        <td><small class="text-muted">@(string.IsNullOrEmpty(u.UpiId) ? "-" : u.UpiId)</small></td>
                        <td>
                            @foreach (var r in u.Roles)
                            {
                                <span class="badge @(r == "SystemAdmin" ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary") me-1">
                                    @r
                                </span>
                            }
                        </td>
                        <td class="small text-muted">@u.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (u.IsLockedOut)
                            {
                                <span class="badge bg-danger">Locked Out</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success">Active</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <form asp-action="ToggleAdminRole" method="post" class="d-inline">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <button type="submit" class="btn btn-outline-secondary" title="Toggle SystemAdmin role">
                                        <i class="bi bi-shield-check"></i>
                                    </button>
                                </form>
                                <form asp-action="ToggleLockout" method="post" class="d-inline">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <button type="submit" class="btn @(u.IsLockedOut ? "btn-outline-success" : "btn-outline-danger")" title="Toggle Lockout">
                                        <i class="bi @(u.IsLockedOut ? "bi-unlock" : "bi-lock")"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
