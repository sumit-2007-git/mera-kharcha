@model IEnumerable<MeraKharcha.Models.Group>
@{
    ViewData["Title"] = "All Groups Moderation";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-collection-fill text-primary me-2"></i>Groups Moderation</h3>
        <p class="text-muted small mb-0">Overview and controls for all user groups in the system</p>
    </div>
    <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="bi bi-arrow-left me-1"></i> Admin Console
    </a>
</div>

<div class="card-modern p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Group</th>
                    <th>Invite Code</th>
                    <th>Owner</th>
                    <th>Members</th>
                    <th>Expenses Logged</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td>
                            <a asp-area="" asp-controller="Groups" asp-action="Details" asp-route-id="@g.Id" class="fw-bold text-decoration-none text-body">
                                @g.Name
                            </a>
                            <small class="text-muted d-block">Created @g.CreatedAt.ToString("MMM dd, yyyy")</small>
                        </td>
                        <td><code>@g.InviteCode</code></td>
                        <td>@(g.CreatedBy?.FullName ?? "User")</td>
                        <td><span class="badge bg-secondary-subtle text-secondary">@g.Members.Count members</span></td>
                        <td><span class="fw-bold">@g.Expenses.Count</span> (₹@g.Expenses.Sum(e => e.Amount).ToString("N0"))</td>
                        <td>
                            @if (g.IsArchived)
                            {
                                <span class="badge bg-warning">Archived</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success">Active</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleArchive" asp-route-id="@g.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    @(g.IsArchived ? "Unarchive" : "Archive")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
