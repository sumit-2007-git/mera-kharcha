@model MeraKharcha.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="row justify-content-center pt-3">
    <div class="col-md-8 col-lg-6">
        <div class="card-modern p-4 p-md-5 shadow-lg">
            <div class="text-center mb-4">
                <div class="stat-icon-wrapper bg-success text-white mx-auto mb-3" style="width: 54px; height: 54px; font-size: 1.5rem;">
                    <i class="bi bi-person-plus"></i>
                </div>
                <h3 class="fw-bold">Join Mera Kharcha</h3>
                <p class="text-muted small">Start organizing group expenses and settling debts smoothly</p>
            </div>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label small fw-semibold">Full Name</label>
                    <div class="input-group">
                        <span class="input-group-text bg-body-tertiary"><i class="bi bi-person"></i></span>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Vikram Malhotra" />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-body-tertiary"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="e.g. vikram@gmail.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UpiId" class="form-label small fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-body-tertiary"><i class="bi bi-qr-code"></i></span>
                        <input asp-for="UpiId" class="form-control" placeholder="e.g. vikram@okhdfcbank" />
                    </div>
                    <small class="text-muted">Friends can pay you settlements directly to this UPI ID.</small>
                    <span asp-validation-for="UpiId" class="text-danger small"></span>
                </div>

                <div class="row g-2 mb-4">
                    <div class="col-sm-6">
                        <label asp-for="Password" class="form-label small fw-semibold">Password</label>
                        <input asp-for="Password" class="form-control" placeholder="At least 6 chars" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold">Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-success w-100 py-2 rounded-3 fw-semibold shadow-sm mb-3">
                    <i class="bi bi-check-circle me-1"></i> Create Account
                </button>
            </form>

            <div class="text-center pt-2 border-top border-light">
                <span class="small text-muted">Already registered? </span>
                <a asp-action="Login" class="small fw-semibold text-primary text-decoration-none">Sign in here</a>
            </div>
        </div>
    </div>
</div>
