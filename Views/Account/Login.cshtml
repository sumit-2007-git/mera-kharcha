@model MeraKharcha.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center pt-3">
    <div class="col-md-7 col-lg-5">
        <div class="card-modern p-4 p-md-5 shadow-lg">
            <div class="text-center mb-4">
                <div class="stat-icon-wrapper bg-primary text-white mx-auto mb-3" style="width: 54px; height: 54px; font-size: 1.5rem;">
                    <i class="bi bi-wallet2"></i>
                </div>
                <h3 class="fw-bold">Welcome Back</h3>
                <p class="text-muted small">Sign in to manage your shared expenses & settlements</p>
            </div>

            <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-body-tertiary"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" id="loginEmail" placeholder="e.g. rahul@merakharcha.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="form-label small fw-semibold mb-0">Password</label>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-body-tertiary"><i class="bi bi-key"></i></span>
                        <input asp-for="Password" class="form-control" id="loginPassword" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small text-muted">Keep me signed in</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-semibold shadow-sm mb-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                </button>
            </form>

            <div class="text-center pt-2 border-top border-light">
                <span class="small text-muted">Don't have an account? </span>
                <a asp-action="Register" class="small fw-semibold text-primary text-decoration-none">Create one for free</a>
            </div>

            <!-- Visual Studio 2022 Quick Fill Section -->
            <div class="mt-4 p-3 bg-body-tertiary rounded-3 border border-light">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <small class="fw-bold text-muted text-uppercase" style="font-size: 0.7rem;">Quick Fill Test Accounts</small>
                    <span class="badge bg-primary-subtle text-primary" style="font-size: 0.65rem;">Click to fill</span>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="fillCreds('rahul@merakharcha.com', 'User@123')">
                        Rahul (User)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="fillCreds('priya@merakharcha.com', 'User@123')">
                        Priya (User)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="fillCreds('admin@merakharcha.com', 'Admin@123')">
                        Admin (SystemAdmin)
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillCreds(email, pass) {
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = pass;
        }
    </script>
}
