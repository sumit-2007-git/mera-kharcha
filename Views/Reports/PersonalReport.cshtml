@model IEnumerable<MeraKharcha.Models.Expense>
@{
    ViewData["Title"] = "Personal Financial Report";
    var user = ViewBag.User as MeraKharcha.Models.ApplicationUser;
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h3 class="fw-bold mb-1">My Financial Spending Report</h3>
        <p class="text-muted small mb-0">Overview of all expenses paid by you across all groups</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="PersonalReport" asp-route-format="csv" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </a>
        <button type="button" class="btn btn-primary shadow-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print / PDF
        </button>
    </div>
</div>

<div class="card-modern p-4 p-md-5">
    <div class="row g-3 mb-4 p-3 bg-body-tertiary rounded-3 border">
        <div class="col-sm-4 text-center border-end">
            <span class="small text-muted d-block">Total Paid by You</span>
            <h4 class="fw-bold text-primary mb-0">₹@ViewBag.TotalPaid.ToString("N2")</h4>
        </div>
        <div class="col-sm-4 text-center border-end">
            <span class="small text-muted d-block">Total Responsible Share</span>
            <h4 class="fw-bold text-info mb-0">₹@ViewBag.TotalShare.ToString("N2")</h4>
        </div>
        <div class="col-sm-4 text-center">
            <span class="small text-muted d-block">Overall Net Position</span>
            <h4 class="fw-bold @(ViewBag.NetOverall > 0 ? "text-success" : ViewBag.NetOverall < 0 ? "text-danger" : "") mb-0">
                @(ViewBag.NetOverall > 0 ? "+" : "")₹@ViewBag.NetOverall.ToString("N2")
            </h4>
        </div>
    </div>

    <h5 class="fw-bold mb-3">Itemized Expenses Paid by You</h5>
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle border">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Group</th>
                        <th>Expense</th>
                        <th>Category</th>
                        <th class="text-end">Amount Paid</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var exp in Model)
                    {
                        <tr>
                            <td class="small">@exp.ExpenseDate.ToString("yyyy-MM-dd")</td>
                            <td><span class="badge bg-body-secondary text-body">@exp.Group.Name</span></td>
                            <td class="fw-semibold">@exp.Title</td>
                            <td>@(exp.Category?.Name ?? "General")</td>
                            <td class="text-end fw-bold text-primary">₹@exp.Amount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted small text-center py-4">No expenses recorded as paid by you yet.</p>
    }
</div>
