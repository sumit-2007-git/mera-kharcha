@model MeraKharcha.ViewModels.JoinGroupViewModel
@{
    ViewData["Title"] = "Join Group";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card-modern p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="stat-icon-wrapper bg-success text-white mx-auto mb-3" style="width: 54px; height: 54px; font-size: 1.5rem;">
                    <i class="bi bi-qr-code-scan"></i>
                </div>
                <h4 class="fw-bold">Join an Expense Group</h4>
                <p class="text-muted small">Enter the 6-character invite code provided by your group organizer</p>
            </div>

            <form asp-action="Join" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="InviteCode" class="form-label small fw-semibold text-uppercase">Invite Code</label>
                    <input asp-for="InviteCode" class="form-control form-control-lg text-center fw-bold text-uppercase letter-spacing-2" placeholder="e.g. GOA2026" maxlength="10" style="letter-spacing: 0.15em;" />
                    <span asp-validation-for="InviteCode" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-success w-100 py-2 rounded-3 fw-semibold shadow-sm mb-3">
                    <i class="bi bi-door-open me-1"></i> Join Group Workspace
                </button>
            </form>

            <div class="text-center pt-3 border-top">
                <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-muted">
                    <i class="bi bi-arrow-left me-1"></i> Back to My Groups
                </a>
            </div>
        </div>
    </div>
</div>
