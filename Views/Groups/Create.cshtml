@model MeraKharcha.ViewModels.CreateGroupViewModel
@{
    ViewData["Title"] = "Create New Group";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card-modern p-4 p-md-5">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="stat-icon-wrapper bg-primary text-white" style="width: 48px; height: 48px; font-size: 1.3rem;">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">Create Expense Group</h4>
                    <p class="text-muted small mb-0">Start tracking and splitting expenses together</p>
                </div>
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-semibold">Group Name *</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Manali Adventure Trip, Room 302..." />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label small fw-semibold">Description / Notes</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="What is this group for?"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold">Choose Group Icon</label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var icon in new[] { "bi-compass", "bi-buildings", "bi-tsunami", "bi-cup-hot", "bi-airplane", "bi-basket", "bi-lightning-charge", "bi-controller" })
                        {
                            <label class="btn btn-outline-secondary p-2 rounded-3 text-center" style="width: 48px; height: 48px;">
                                <input type="radio" asp-for="ImageUrl" value="@icon" class="btn-check" />
                                <i class="bi @icon fs-5"></i>
                            </label>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-check2 me-1"></i> Create Group
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
