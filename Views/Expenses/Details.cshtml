@model MeraKharcha.Models.Expense
@{
    ViewData["Title"] = "Expense Details - " + Model.Title;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-modern p-4 p-md-5">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-start mb-4 pb-3 border-bottom">
                <div>
                    <span class="badge rounded-pill mb-2" style="background-color: @(Model.Category?.ColorHex ?? "#3B82F6")20; color: @(Model.Category?.ColorHex ?? "#3B82F6"); border: 1px solid @(Model.Category?.ColorHex ?? "#3B82F6")40;">
                        <i class="bi @(Model.Category?.Icon ?? "bi-tag") me-1"></i>@(Model.Category?.Name ?? "General")
                    </span>
                    <h3 class="fw-bold mb-1">@Model.Title</h3>
                    <small class="text-muted">
                        Group: <a asp-controller="Groups" asp-action="Details" asp-route-id="@Model.GroupId" class="text-decoration-none fw-semibold">@Model.Group.Name</a> &bull; Date: @Model.ExpenseDate.ToString("MMMM dd, yyyy")
                    </small>
                </div>
                <div class="text-end">
                    <span class="small text-muted d-block">Total Amount</span>
                    <h2 class="fw-bold text-primary mb-0">₹@Model.Amount.ToString("N2")</h2>
                </div>
            </div>

            <!-- Financial Breakdown Grid -->
            <div class="p-3 bg-body-tertiary rounded-3 border mb-4">
                <h6 class="fw-bold small text-muted text-uppercase mb-2">Cost Breakdown</h6>
                <div class="row g-2 small">
                    <div class="col-6 col-sm-3">
                        <span class="text-muted d-block">Base Price:</span>
                        <span class="fw-semibold">₹@Model.BaseAmount.ToString("N2")</span>
                    </div>
                    @if (Model.TaxAmount > 0)
                    {
                        <div class="col-6 col-sm-3">
                            <span class="text-muted d-block">Tax:</span>
                            <span class="fw-semibold">+₹@Model.TaxAmount.ToString("N2")</span>
                        </div>
                    }
                    @if (Model.TipAmount > 0)
                    {
                        <div class="col-6 col-sm-3">
                            <span class="text-muted d-block">Tip / Gratuity:</span>
                            <span class="fw-semibold">+₹@Model.TipAmount.ToString("N2")</span>
                        </div>
                    }
                    @if (Model.ServiceCharge > 0)
                    {
                        <div class="col-6 col-sm-3">
                            <span class="text-muted d-block">Service Charge:</span>
                            <span class="fw-semibold">+₹@Model.ServiceCharge.ToString("N2")</span>
                        </div>
                    }
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="col-6 col-sm-3">
                            <span class="text-muted d-block text-danger">Discount:</span>
                            <span class="fw-semibold text-danger">-₹@Model.DiscountAmount.ToString("N2")</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Payer and Split Type -->
            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <div class="p-3 border rounded-3 bg-body-tertiary h-100">
                        <span class="text-muted small d-block mb-1">Paid In Full By</span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 34px; height: 34px;">
                                @(Model.PaidByUser.FullName.Substring(0, 1).ToUpper())
                            </div>
                            <div>
                                <span class="fw-bold">@Model.PaidByUser.FullName</span>
                                <small class="text-muted d-block">@Model.PaidByUser.Email</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 border rounded-3 bg-body-tertiary h-100">
                        <span class="text-muted small d-block mb-1">Split Method Used</span>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-pie-chart text-primary fs-4"></i>
                            <div>
                                <span class="fw-bold">@Model.SplitType Split</span>
                                <small class="text-muted d-block">Divided among @Model.Participants.Count participants</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Participant Allocation Table -->
            <h5 class="fw-bold mb-3"><i class="bi bi-people text-primary me-2"></i>Participant Share Allocations</h5>
            <div class="table-responsive mb-4">
                <table class="table table-hover align-middle border rounded-3 mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Participant</th>
                            <th>Split Detail</th>
                            <th class="text-end">Owed Share</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Participants)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@p.User.FullName</div>
                                    <small class="text-muted">@p.User.Email</small>
                                </td>
                                <td>
                                    @if (p.Percentage.HasValue)
                                    {
                                        <span class="badge bg-body-secondary text-secondary">@p.Percentage.Value%</span>
                                    }
                                    else if (p.SharesCount.HasValue)
                                    {
                                        <span class="badge bg-body-secondary text-secondary">@p.SharesCount.Value share(s)</span>
                                    }
                                    else if (p.ExactAmount.HasValue)
                                    {
                                        <span class="badge bg-body-secondary text-secondary">Exact</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-body-secondary text-secondary">Equal</span>
                                    }
                                </td>
                                <td class="text-end fw-bold text-primary">
                                    ₹@p.ShareAmount.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Receipt Attachment Preview -->
            @if (!string.IsNullOrEmpty(Model.ReceiptUrl))
            {
                <div class="p-3 border rounded-3 bg-body-tertiary mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold mb-0"><i class="bi bi-paperclip me-1 text-info"></i>Attached Bill Receipt</h6>
                        <a href="@Model.ReceiptUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Open Full View
                        </a>
                    </div>
                    @if (Model.ReceiptUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="p-3 text-center bg-white rounded border">
                            <i class="bi bi-file-earmark-pdf fs-1 text-danger"></i>
                            <div class="small fw-semibold mt-1">PDF Receipt Document Attached</div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center bg-black bg-opacity-10 p-2 rounded">
                            <img src="@Model.ReceiptUrl" class="img-fluid rounded shadow-sm" style="max-height: 280px;" alt="Receipt Preview" />
                        </div>
                    }
                </div>
            }

            <!-- Bottom Navigation -->
            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                <a asp-controller="Groups" asp-action="Details" asp-route-id="@Model.GroupId" asp-route-tab="expenses" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Group
                </a>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this expense?');">
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i> Delete Expense
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
