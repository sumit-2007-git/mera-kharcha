<div class="dropdown me-2" id="notificationDropdown">
    <button class="btn btn-outline-secondary position-relative border-0 rounded-circle p-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
        <i class="bi bi-bell-fill fs-5"></i>
        <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.65rem;">
            0
        </span>
    </button>
    <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-0" style="width: 320px; max-height: 420px; overflow-y: auto; border-radius: 1rem;">
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom bg-body-tertiary">
            <h6 class="mb-0 fw-bold"><i class="bi bi-bell me-2"></i>Notifications</h6>
            <button type="button" class="btn btn-link btn-sm text-decoration-none p-0" onclick="markAllNotificationsRead()">
                <small>Mark all read</small>
            </button>
        </div>
        <div id="notificationList">
            <div class="text-center py-4 text-muted">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <div class="small mt-1">Loading alerts...</div>
            </div>
        </div>
        <div class="p-2 border-top text-center bg-body-tertiary">
            <a asp-controller="Notifications" asp-action="Index" class="btn btn-sm btn-link text-decoration-none fw-semibold">
                View All Notifications <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</div>
