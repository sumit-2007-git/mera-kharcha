@using Microsoft.AspNetCore.Identity
@using MeraKharcha.Models
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mera Kharcha</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom Modern CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
@{
    var currentUserId = User.Identity?.IsAuthenticated == true ? UserManager.GetUserId(User) : null;
    var currentGroupId = ViewBag.GroupId != null ? ViewBag.GroupId.ToString() : null;
}
<body data-user-id="@currentUserId" data-group-id="@currentGroupId">
    <div class="app-wrapper">
        <!-- Responsive Sidebar -->
        <partial name="_Sidebar" />

        <!-- Main Content Area -->
        <div class="app-main">
            <!-- Top Navbar -->
            <header class="app-navbar d-flex align-items-center justify-content-between px-3 px-lg-4">
                <div class="d-flex align-items-center gap-3">
                    <button id="sidebarToggleBtn" class="btn btn-outline-secondary d-lg-none border-0 p-1" type="button" aria-label="Toggle Navigation">
                        <i class="bi bi-list fs-3"></i>
                    </button>
                    <span class="fs-5 fw-bold d-none d-sm-inline text-truncate" style="max-width: 300px;">
                        @(ViewData["Title"] ?? "Mera Kharcha")
                    </span>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <!-- Dark / Light Mode Switcher -->
                    <button id="themeToggleBtn" class="btn btn-outline-secondary border-0 rounded-circle p-2" type="button" title="Toggle Light/Dark theme">
                        <i id="themeIcon" class="bi bi-moon-stars-fill text-secondary"></i>
                    </button>

                    <!-- Notifications Dropdown -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <partial name="_NotificationBell" />
                    }

                    <!-- User Account Dropdown -->
                    <partial name="_LoginPartial" />
                </div>
            </header>

            <!-- Main Page View Content -->
            <main class="app-content">
                <!-- Global Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                        <div>@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show rounded-4 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        <div>@TempData["InfoMessage"]</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <footer class="mt-auto py-3 px-4 border-top bg-surface text-muted text-center small">
                <div class="container-fluid d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                    <div>&copy; @DateTime.Now.Year - <strong>Mera Kharcha</strong> | Smart Split Expense Tracker</div>
                    <div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle me-1">
                            <i class="bi bi-lightning-charge-fill me-1"></i>Min-Transaction Optimizer Active
                        </span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                            ASP.NET Core .NET 8
                        </span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Microsoft SignalR Client -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <!-- Application Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
