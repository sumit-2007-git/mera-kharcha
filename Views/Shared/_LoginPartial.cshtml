@using Microsoft.AspNetCore.Identity
@using MeraKharcha.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2 border-0 rounded-pill py-1 px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            @if (!string.IsNullOrEmpty(user?.AvatarUrl))
            {
                <img src="@user.AvatarUrl" class="rounded-circle object-fit-cover" style="width: 28px; height: 28px;" alt="Avatar" />
            }
            else
            {
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.8rem;">
                    @(user?.FullName?.Substring(0, 1).ToUpper() ?? "U")
                </div>
            }
            <span class="d-none d-md-inline fw-semibold small">@(user?.FullName ?? user?.UserName)</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2" style="border-radius: 0.75rem;">
            <li>
                <div class="dropdown-item-text">
                    <div class="fw-bold">@(user?.FullName)</div>
                    <small class="text-muted">@(user?.Email)</small>
                </div>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Account" asp-action="Profile">
                    <i class="bi bi-person"></i> My Profile
                </a>
            </li>
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Account" asp-action="ChangePassword">
                    <i class="bi bi-key"></i> Change Password
                </a>
            </li>
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Reports" asp-action="PersonalReport">
                    <i class="bi bi-pie-chart"></i> My Expense Report
                </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                        <i class="bi bi-box-arrow-right"></i> Sign Out
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm px-3 rounded-pill">Log In</a>
        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm px-3 rounded-pill shadow-sm">Get Started</a>
    </div>
}
