@model IEnumerable<MeraKharcha.Models.InAppNotification>
@{
    ViewData["Title"] = "Notification Center";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1"><i class="bi bi-bell-fill text-primary me-2"></i>Notifications</h3>
                <p class="text-muted small mb-0">Stay updated with expenses, payments, and group activities</p>
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="markAllNotificationsRead(); location.reload();">
                <i class="bi bi-check-all me-1"></i> Mark All as Read
            </button>
        </div>

        <div class="card-modern p-3 p-md-4">
            @if (Model.Any())
            {
                <div class="vstack gap-2">
                    @foreach (var n in Model)
                    {
                        <div class="p-3 border rounded-3 d-flex align-items-start gap-3 @(!n.IsRead ? "bg-primary-subtle bg-opacity-25 border-primary border-opacity-25" : "bg-body-tertiary")">
                            <div class="stat-icon-wrapper rounded-circle bg-light text-primary" style="width: 40px; height: 40px;">
                                <i class="bi bi-bell"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="fw-bold mb-0">@n.Title</h6>
                                    <small class="text-muted">@n.CreatedAt.ToString("g")</small>
                                </div>
                                <p class="mb-2 small text-secondary">@n.Message</p>
                                @if (!string.IsNullOrEmpty(n.LinkUrl))
                                {
                                    <a href="@n.LinkUrl" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill" style="font-size: 0.75rem;">
                                        View Details <i class="bi bi-arrow-right"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-bell-slash fs-1 d-block mb-2"></i>
                    <p class="small">No notifications found.</p>
                </div>
            }
        </div>
    </div>
</div>
