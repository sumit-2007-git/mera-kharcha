@{
    ViewData["Title"] = "Mera Kharcha - Smart Split Expense Tracker";
    Layout = "_Layout";
}

<div class="container-fluid px-0">
    <!-- Hero Section with Solcon Solar Gradient -->
    <div class="card-modern border-0 p-4 p-lg-5 mb-5" style="background: linear-gradient(135deg, rgba(255, 107, 0, 0.06) 0%, rgba(255, 168, 0, 0.10) 100%); border: 1px solid rgba(255, 107, 0, 0.15) !important;">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="badge badge-solar px-3 py-2 rounded-pill mb-3 shadow-sm">
                    <i class="bi bi-sun-fill me-1 text-warning"></i> Smart Splitwise Alternative for India
                </span>
                <h1 class="display-4 fw-extrabold mb-3" style="font-weight: 800; letter-spacing: -0.025em;">
                    Split Expenses with Friends. <br />
                    <span class="text-gradient-solar">Settle in Minimum Transfers.</span>
                </h1>
                <p class="lead text-muted mb-4">
                    <strong>Mera Kharcha</strong> is a modern collaborative expense management platform for trips, flatmates, families, and teams. Powered by our <strong>Greedy Minimum-Transaction Settlement Engine</strong>, it reduces dozens of confusing debts into a handful of direct UPI payments.
                </p>

                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4 rounded-pill shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Open Dashboard
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">
                        <i class="bi bi-person-plus me-2"></i> Create Free Account
                    </a>
                </div>

                <!-- Metrics Counter Bar -->
                <div class="row g-3 pt-3 border-top border-light">
                    <div class="col-4">
                        <div class="fs-4 fw-bold text-solar">@ViewBag.TotalGroups+</div>
                        <small class="text-muted">Active Workspaces</small>
                    </div>
                    <div class="col-4">
                        <div class="fs-4 fw-bold text-success">@ViewBag.TotalExpensesCount+</div>
                        <small class="text-muted">Expenses Tracked</small>
                    </div>
                    <div class="col-4">
                        <div class="fs-4 fw-bold text-warning">₹@string.Format("{0:N0}", ViewBag.TotalVolume)</div>
                        <small class="text-muted">Total Volume</small>
                    </div>
                </div>
            </div>

            <!-- Demo Quick-Access Card -->
            <div class="col-lg-5">
                <div class="card-modern p-4 shadow-lg border-warning border-opacity-50">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="fw-bold mb-0"><i class="bi bi-key-fill text-warning me-2"></i>Quick Demo Login</h5>
                        <span class="badge bg-success-subtle text-success">Pre-Seeded</span>
                    </div>
                    <p class="small text-muted mb-3">
                        Click any pre-seeded profile below to quickly test in Visual Studio 2022:
                    </p>

                    <div class="vstack gap-2">
                        <form asp-controller="Account" asp-action="Login" method="post" class="d-grid">
                            <input type="hidden" name="Email" value="rahul@merakharcha.com" />
                            <input type="hidden" name="Password" value="User@123" />
                            <button type="submit" class="btn btn-outline-primary d-flex align-items-center justify-content-between p-2 rounded-3 text-start">
                                <div>
                                    <div class="fw-bold small">Rahul Sharma (Trip Organizer)</div>
                                    <small class="text-muted">rahul@merakharcha.com &bull; User@123</small>
                                </div>
                                <i class="bi bi-arrow-right-circle fs-5"></i>
                            </button>
                        </form>

                        <form asp-controller="Account" asp-action="Login" method="post" class="d-grid">
                            <input type="hidden" name="Email" value="priya@merakharcha.com" />
                            <input type="hidden" name="Password" value="User@123" />
                            <button type="submit" class="btn btn-outline-primary d-flex align-items-center justify-content-between p-2 rounded-3 text-start">
                                <div>
                                    <div class="fw-bold small">Priya Patel (Flat Owner)</div>
                                    <small class="text-muted">priya@merakharcha.com &bull; User@123</small>
                                </div>
                                <i class="bi bi-arrow-right-circle fs-5"></i>
                            </button>
                        </form>

                        <form asp-controller="Account" asp-action="Login" method="post" class="d-grid">
                            <input type="hidden" name="Email" value="admin@merakharcha.com" />
                            <input type="hidden" name="Password" value="Admin@123" />
                            <button type="submit" class="btn btn-outline-danger d-flex align-items-center justify-content-between p-2 rounded-3 text-start">
                                <div>
                                    <div class="fw-bold small text-danger">System Administrator</div>
                                    <small class="text-muted">admin@merakharcha.com &bull; Admin@123</small>
                                </div>
                                <i class="bi bi-shield-check fs-5 text-danger"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Feature Highlights -->
    <div class="mb-5">
        <div class="text-center mb-4">
            <h2 class="fw-bold">Everything you need for Smart Group Finances</h2>
            <p class="text-muted">Built according to the Advanced ASP.NET Core MVC blueprint</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card-modern p-4 h-100">
                    <div class="stat-icon-wrapper bg-primary text-white mb-3">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                    <h5 class="fw-bold">Minimum-Transaction Engine</h5>
                    <p class="text-muted small">
                        Calculates net balances and pairs largest debtors with creditors via graph cash-flow reduction, saving countless peer-to-peer transfers.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card-modern p-4 h-100">
                    <div class="stat-icon-wrapper bg-success text-white mb-3">
                        <i class="bi bi-pie-chart-fill"></i>
                    </div>
                    <h5 class="fw-bold">4 Flexible Split Methods</h5>
                    <p class="text-muted small">
                        Support for Equal, Exact Amount, Percentage, and Ratio/Share based splitting, plus proportional Tax, Tip, Service Charge, and Discounts.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card-modern p-4 h-100">
                    <div class="stat-icon-wrapper bg-warning text-white mb-3">
                        <i class="bi bi-broadcast"></i>
                    </div>
                    <h5 class="fw-bold">Real-time SignalR Updates</h5>
                    <p class="text-muted small">
                        Instant push notifications for new group expenses, settlement confirmations, and membership joins without manual page refreshes.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card-modern p-4 h-100">
                    <div class="stat-icon-wrapper bg-info text-white mb-3">
                        <i class="bi bi-qr-code-scan"></i>
                    </div>
                    <h5 class="fw-bold">QR Join & Shareable Invites</h5>
                    <p class="text-muted small">
                        Generate instant QR codes and 6-digit invite codes for friends to join groups effortlessly on any smartphone.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card-modern p-4 h-100">
                    <div class="stat-icon-wrapper bg-danger text-white mb-3">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                    <h5 class="fw-bold">Recurring Bills & Reminders</h5>
                    <p class="text-muted small">
                        Automate regular flat rent, maid salary, electricity, and broadband subscriptions with automatic due-date trackers.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card-modern p-4 h-100">
                    <div class="stat-icon-wrapper bg-secondary text-white mb-3">
                        <i class="bi bi-file-earmark-pdf-fill"></i>
                    </div>
                    <h5 class="fw-bold">Export to PDF & CSV</h5>
                    <p class="text-muted small">
                        One-click downloadable CSV sheets and beautiful printable PDF audit invoices for transparent accounting and expense claims.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
